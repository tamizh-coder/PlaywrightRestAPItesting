//Level 3: Count Any Character

 function countcharacter(word:string,letter:string):number{
    let count=0;
    for(const ch of word)
    {
        if (ch.toLowerCase()===letter.toLowerCase())
        {count++;}
    }return count;

 }console.log(countcharacter("banananana","a"))